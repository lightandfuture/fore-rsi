{% if task_revision is defined %}
## Task revision {{ task_revision.revision_number }}

### Objective
{{ task_revision.task_submission.goal }}

{% set submission = task_revision.task_submission %}
{% if submission.constraints.common_constraints %}
### Constraints
{% for name, value in submission.constraints.common_constraints.items() %}
- {{ name }}: {{ value }}
{% endfor %}
{% endif %}

{% if submission.constraints.resources.deployment_resources or submission.constraints.resources.experiment_resources %}
### Authorized resources
{% if submission.constraints.resources.deployment_resources %}
- Deployment: {{ submission.constraints.resources.deployment_resources }}
{% endif %}
{% if submission.constraints.resources.experiment_resources %}
- Experiments: {{ submission.constraints.resources.experiment_resources }}
{% endif %}
{% endif %}

{% if submission.constraints.stop_conditions %}
### Stop conditions
{% for condition in submission.constraints.stop_conditions %}
- {{ condition }}
{% endfor %}
{% endif %}

{% if submission.constraints.time_budget is not none %}
### Time budget
{{ submission.constraints.time_budget }} seconds.
{% endif %}

{% if submission.agent_team.roles %}
### Agent team
{% for role, allocations in submission.agent_team.roles.items() %}
- {{ role }}:
{% for allocation in allocations %}
  - model: {{ allocation.model }}, effort: {{ allocation.effort }}, quota: {{ allocation.quota }}
{% endfor %}
{% endfor %}
{% endif %}

{% if submission.agent_team.team_comments %}
### Team comments
{% for comment in submission.agent_team.team_comments %}
- {{ comment }}
{% endfor %}
{% endif %}

{% if submission.environment_variables %}
### Environment variables
{% for name, value in submission.environment_variables.items() %}
- {{ name }}={{ value }}
{% endfor %}
{% endif %}

{% if submission.task_comments %}
### Task comments
{% for comment in submission.task_comments %}
- {{ comment }}
{% endfor %}
{% endif %}
{% else %}
Read the task declaration for the objective, constraints, authorized resources, stop conditions, time budget, agent-team allocations, environment variables, and task comments.
{% endif %}
